{
  "id": "inertia_bounce",
  "name": "Inertia Bounce",
  "version": "1.0.0",
  "category": "Motion",
  "author": "OpenFlow",
  "description": "Decaying sinusoidal bounce animation expression",
  "entryPoint": "expression.js",
  "type": "ExpressionPreset",
  "parameters": [
    {
      "key": "amp",
      "label": "Amplitude",
      "type": "FloatSlider",
      "min": 0.0,
      "max": 1.0,
      "default": 0.05
    },
    {
      "key": "freq",
      "label": "Frequency",
      "type": "FloatSlider",
      "min": 0.1,
      "max": 10.0,
      "default": 4.0
    },
    {
      "key": "decay",
      "label": "Decay",
      "type": "FloatSlider",
      "min": 0.1,
      "max": 10.0,
      "default": 2.0
    }
  ]
}
